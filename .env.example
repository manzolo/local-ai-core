# Copy to .env and change what you need. Every value below is the default.

# Where the gateway listens. 127.0.0.1 = this machine only; 0.0.0.0 opens it to your network
# (then set LOCAL_AI_API_KEY too).
BIND_ADDR=127.0.0.1
GATEWAY_PORT=8090

# Optional API key: when set, every /v1 call needs the header `X-API-Key: <key>`.
LOCAL_AI_API_KEY=

# Largest request body accepted, in MB.
MAX_UPLOAD_MB=50

# Your notes: a folder of Markdown files, mounted read-only. Default: the example notes.
NOTES_DIR=./examples/notes

# Ollama. The default is the one this stack brings; with docker-compose.local-ai.yml it is the family's.
OLLAMA_HOST=http://ollama:11434
# The model that writes answers, and the one that turns text into vectors for the search.
OLLAMA_MODEL=qwen3.5:9b
EMBED_MODEL=bge-m3

# Download missing models and index the notes when the gateway starts.
AUTO_PULL_MODELS=true
AUTO_INDEX=true

# Minimum similarity for a search hit (0..1), and minutes of inactivity before Ollama unloads a model.
SEARCH_MIN_SCORE=0.35
IDLE_UNLOAD_MINUTES=10

# Images (profile `image`): another SDXL checkpoint instead of SDXL base 1.0. Put the .safetensors file
# in the image-models volume, under checkpoints/, and check its license.
IMAGE_CHECKPOINT=

# Handwriting (profile `handwriting`): the vision model on Ollama that reads the photos.
VISION_MODEL=qwen3-vl:8b-instruct

# Voice (profile `voice`): XTTS-v2 is under the Coqui Public Model License, which allows NON-COMMERCIAL use
# only, of the model and of the audio it makes (https://huggingface.co/coqui/XTTS-v2/blob/main/LICENSE.txt). The voice service stays off
# until you accept it here, by writing yes.
XTTS_ACCEPT_CPML=
